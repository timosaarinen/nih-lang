{
  "name": "nih-lang",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "NIH v3: agent-native unified CPU/GPU language",
  "scripts": {
    "dev": "bunx --bun vite",
    "build:web": "tsc -p tsconfig.web.json && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "check:web": "tsc -p tsconfig.web.json",
    "build": "bun run build:cli && bun run build:web",
    "build:cli": "tsc -p tsconfig.json",
    "check": "npm run build:cli && node --test dist/test/*.test.js",
    "test": "npm run check",
    "nih": "node dist/src/cli.js",
    "demo": "npm run build:demos && node dist/src/cli.js run examples/unified.nih && node dist/src/cli.js gpu examples/unified.nih",
    "build:demos": "npm run build:cli && node tools/build-web-demos.mjs",
    "serve:demos": "npm run build:demos && npx --yes serve runtime/web"
  },
  "dependencies": { "monaco-editor": "0.57.0" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "packageManager": "bun@1.4.5",
  "engines": { "node": ">=22.12", "bun": ">=1.4.5" },
  "license": "MIT"
}
